# Public Sanity configuration
NEXT_PUBLIC_SANITY_PROJECT_ID="your-project-id"
NEXT_PUBLIC_SANITY_DATASET="production"
NEXT_PUBLIC_SANITY_API_VERSION="2026-08-01"

# Server-only. Required only for the one-time seed command.
SANITY_API_WRITE_TOKEN="your-editor-token"

# Server-only. Use the same value in the Sanity webhook settings.
SANITY_REVALIDATE_SECRET="replace-with-a-long-random-secret"
